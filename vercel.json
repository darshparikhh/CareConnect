{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "backend/api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/health", "dest": "backend/api/index.py" },
    { "src": "/auth/(.*)", "dest": "backend/api/index.py" },
    { "src": "/register/(.*)", "dest": "backend/api/index.py" },
    { "src": "/patient/(.*)", "dest": "backend/api/index.py" },
    { "src": "/volunteer/(.*)", "dest": "backend/api/index.py" },
    { "src": "/clinician/(.*)", "dest": "backend/api/index.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
