# Base URL of the CareConnect FastAPI backend.
#
# LOCAL DEV: leave unset (or use http://localhost:8000). The app falls back to
# http://localhost:8000 in dev — see src/api/client.ts.
#
# PRODUCTION (Vercel): set this to your deployed Render backend URL, e.g.
#   VITE_API_BASE_URL=https://careconnect-backend.onrender.com
# Vite inlines this at BUILD time, so it must be set in the Vercel project's
# Environment Variables BEFORE the build/deploy (not at runtime).
VITE_API_BASE_URL=http://localhost:8000
